# Build muxcored from MuxCore monorepo root (no private module fetch).
#
#   podman build -f core/Dockerfile.monorepo -t localhost/muxcored:v0.5.8 \
#     --build-arg VERSION=0.5.8 .
#
# Context must be the monorepo root (sibling contracts-media + contracts-reconciler).
FROM golang@sha256:2005724102f45917a63e9d092fc0e4ea56ea575048ce147caad5f5f61502c365 AS build

ARG VERSION=0.0.0-dev

WORKDIR /src
COPY contracts-media /deps/contracts-media
COPY contracts-reconciler /deps/contracts-reconciler
COPY core/ .
RUN go mod edit \
    -replace=github.com/Muxcore-Media/contracts-media=/deps/contracts-media \
    -replace=github.com/Muxcore-Media/contracts-reconciler=/deps/contracts-reconciler && \
    cd pkg/contracts && go mod edit \
    -replace=github.com/Muxcore-Media/contracts-media=/deps/contracts-media
RUN go mod download
RUN CGO_ENABLED=0 go build \
    -ldflags="-s -w -X github.com/Muxcore-Media/core/internal/version.Version=${VERSION}" \
    -o /muxcored \
    ./cmd/muxcored

FROM alpine@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk add --no-cache curl ca-certificates

RUN adduser -D -h /app muxcore
WORKDIR /app
COPY --from=build /muxcored /app/muxcored

USER muxcore
EXPOSE 9090
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -fsS http://127.0.0.1:9090/health || exit 1

ENTRYPOINT ["/app/muxcored"]
