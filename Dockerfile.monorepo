# Monorepo build for muxcored.
#
# Build context is the workspace parent of core/ (sibling repos present), not core/
# alone. Used by mvp/scripts/publish-muxcored-ghcr.sh when contracts-media and
# contracts-reconciler sit next to core/.
#
# Smoke build without GHCR push or write:packages:
#   BUILD_ONLY=1 ../mvp/scripts/publish-muxcored-ghcr.sh v0.5.8
#   # or: ../mvp/scripts/smoke-ghcr-build.sh
#
# Manual equivalent:
#   docker build -f core/Dockerfile.monorepo \
#     --build-arg VERSION=0.5.8 \
#     -t localhost/muxcored:v0.5.8 \
#     .
FROM golang@sha256:f44f6e88636cfb311f9ebace870ded69d943f227bb3cb27d32ffd84ea18c43ea AS build

# VERSION is injected at docker build time:
#   docker build --build-arg VERSION=1.0.0 -t muxcore:1.0.0 .
# Falls back to "0.0.0-dev" when not supplied.
ARG VERSION=0.0.0-dev

WORKDIR /src

# Sibling contract repos (private modules) — copied from monorepo root context
# so go mod does not fetch them from GitHub.
COPY contracts-reconciler/ ./contracts-reconciler/
COPY contracts-media/ ./contracts-media/

# Core module metadata first for layer caching.
COPY core/go.mod core/go.sum ./core/
COPY core/pkg/contracts/go.mod ./core/pkg/contracts/

WORKDIR /src/core
RUN go mod edit -replace=github.com/Muxcore-Media/contracts-reconciler=../contracts-reconciler
RUN go mod download

COPY core/ .

RUN CGO_ENABLED=0 go build \
    -ldflags="-s -w -X github.com/Muxcore-Media/core/internal/version.Version=${VERSION}" \
    -o /muxcored \
    ./cmd/muxcored

FROM alpine@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk add --no-cache curl ca-certificates

RUN adduser -D -h /app muxcore
WORKDIR /app
# Create writable directories for read-only root filesystem compatibility.
RUN mkdir -p /app/data /app/tmp && chown muxcore /app/data /app/tmp
COPY --from=build /muxcored .

USER muxcore
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["sh", "-c", "curl -sf https://127.0.0.1:8080/health || curl -sf http://127.0.0.1:8080/health"]

ENTRYPOINT ["./muxcored"]
