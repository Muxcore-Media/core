# MuxCore Environment Variables
# Copy to .env and fill in values for your environment.
# All variables are optional — defaults shown in comments.

# === Config File ===
# MUXCORE_CONFIG=muxcore.json

# === HTTP Server ===
# MUXCORE_ADDR=:8080
# MUXCORE_TLS_CERT=/etc/ssl/server-cert.pem
# MUXCORE_TLS_KEY=/etc/ssl/server-key.pem

# === gRPC Mesh ===
# MUXCORE_GRPC_TLS_CERT=/etc/ssl/grpc-cert.pem
# MUXCORE_GRPC_TLS_KEY=/etc/ssl/grpc-key.pem
# MUXCORE_GRPC_MTLS_ENABLED=false
# MUXCORE_GRPC_MTLS_CA=/etc/ssl/ca.pem
# MUXCORE_GRPC_SEED_NODES=node1:9090,node2:9090
# MUXCORE_CLUSTER_JOIN_TOKEN=change-me-to-a-strong-secret

# === Logging ===
# MUXCORE_LOG_LEVEL=info           # debug | info | warn | error
# MUXCORE_LOG_FORMAT=text          # text | json

# === Database (driver provided by database module) ===
# MUXCORE_DATABASE_DRIVER=postgres
# MUXCORE_DATABASE_URL=postgres://user:password@host:5432/muxcore

# === Cache (driver provided by cache module) ===
# MUXCORE_CACHE_DRIVER=redis
# MUXCORE_CACHE_URL=redis://host:6379

# === Audit Logging ===
# MUXCORE_AUDIT_PATH=/var/log/muxcore/audit.jsonl

# === Module Capability Policy ===
# MUXCORE_STRICT_CALL_POLICY=false    # true = hard-deny capability mismatches
# MUXCORE_STRICT_PUBLISH_POLICY=false # true = hard-deny event publish mismatches

# === Event Bus / WAL ===
# MUXCORE_EVENT_JOURNAL_PATH=        # enable event WAL at this directory
# MUXCORE_EVENT_REPLAY=true          # replay WAL events on startup

# === Debug & Observability ===
# MUXCORE_DEBUG_ENABLE=false   # true = enable /debug/pprof/* endpoints
# MUXCORE_METRICS_ENABLE=false # true = enable /metrics endpoint

# === Development Only — NEVER use in production ===
# MUXCORE_INSECURE_DISABLE_TLS=false # true = bypass TLS for HTTP and gRPC
